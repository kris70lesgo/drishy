diff --git a/tests/restart_qoi.rs b/tests/restart_qoi.rs
index 55b5f0b..071cfc0 100644
--- a/tests/restart_qoi.rs
+++ b/tests/restart_qoi.rs
@@ -70,0 +71,29 @@ fn restart_stream_round_trips_all_qoi_opcode_shapes_and_block_edges() {
+#[test]
+fn restart_stream_handles_inline_block_range_capacity_edges() {
+    let channels = 3;
+    for pixel_count in [1, 16_385, 32_769, 49_153, 65_536, 65_537] {
+        let header = decode::Header {
+            width: pixel_count as u32,
+            height: 1,
+            channels,
+            colorspace: 0,
+        };
+        let pixels = vec![37; pixel_count * usize::from(channels)];
+        let stream = restart_qoi::encode(header, &pixels).unwrap();
+        let expected_blocks = pixel_count.div_ceil(restart_qoi::DEFAULT_BLOCK_PIXELS);
+        let stored_blocks = u32::from_le_bytes(stream[18..22].try_into().unwrap()) as usize;
+        assert_eq!(stored_blocks, expected_blocks);
+        assert_eq!(
+            restart_qoi::decode(&stream).unwrap(),
+            (header, pixels.clone())
+        );
+
+        let mut reused = vec![0; pixels.len()];
+        assert_eq!(
+            restart_qoi::decode_into(&stream, &mut reused).unwrap(),
+            header
+        );
+        assert_eq!(reused, pixels);
+    }
+}
+
