--- a/src/restart_qoi.rs
+++ b/src/restart_qoi.rs
@@ -13,0 +14 @@ const MAX_BLOCK_COUNT: usize = 1_000_000;
+const INLINE_BLOCK_RANGE_CAPACITY: usize = 4;
@@ -27 +28,39 @@ struct ParsedStream {
-    blocks: Vec<Range<usize>>,
+    blocks: BlockRanges,
+}
+
+enum BlockRanges {
+    Inline {
+        ranges: [Range<usize>; INLINE_BLOCK_RANGE_CAPACITY],
+        len: usize,
+    },
+    Heap(Vec<Range<usize>>),
+}
+
+impl BlockRanges {
+    fn with_capacity(block_count: usize) -> Self {
+        if block_count <= INLINE_BLOCK_RANGE_CAPACITY {
+            Self::Inline {
+                ranges: std::array::from_fn(|_| 0..0),
+                len: 0,
+            }
+        } else {
+            Self::Heap(Vec::with_capacity(block_count))
+        }
+    }
+
+    fn push(&mut self, range: Range<usize>) {
+        match self {
+            Self::Inline { ranges, len } => {
+                ranges[*len] = range;
+                *len += 1;
+            }
+            Self::Heap(ranges) => ranges.push(range),
+        }
+    }
+
+    fn as_slice(&self) -> &[Range<usize>] {
+        match self {
+            Self::Inline { ranges, len } => &ranges[..*len],
+            Self::Heap(ranges) => ranges,
+        }
+    }
